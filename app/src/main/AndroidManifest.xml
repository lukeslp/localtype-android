<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- LocalType's own network use: the Check for updates button (and in the full distribution, the pinned Gemma
         download, whose job and notification permissions come with modelkit's manifest). The F-Droid distribution
         removes both. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice input. Asked for only when the mic key is first tapped; the audio goes to Android's on-device recognizer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Asked for only when the Contacts tool is tapped; contacts are read into memory, never stored or sent. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- On-device speech recognition and other input methods that offer voice typing. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
        <!-- Read aloud's text-to-speech engines, which Android 11 and later hide without this. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Passwords & cards opens the selected autofill service's app; Android 11 and later hide that app without this. -->
        <intent>
            <action android:name="android.service.autofill.AutofillService" />
        </intent>
        <!-- The Tools panel's Send to app lists the apps that take text, as a selection menu does. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- The spell checker reads Android's user dictionary (Add to dictionary). AOSP shows that provider to every
             app; this keeps it visible on a phone that does not. -->
        <provider android:authorities="user_dictionary" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        tools:targetApi="s">

        <!-- LiteRT-LM's optional GPU libraries (libOpenCL.so, libvndksupport.so) come from modelkit's manifest. -->

        <!-- Lets Chrome on the download page see that LocalType is installed (res/values/asset_statements.xml). -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Setup steps back one screen at a time in onBackPressed, which Android 16 stops calling for an app
             that targets API 36 unless the activity opts out of the new back handling here. -->
        <activity
            android:name=".SetupActivity"
            android:enableOnBackInvokedCallback="false"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The model chat opened from About. Its conversation lives only in memory. -->
        <activity
            android:name=".ModelChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Licenses and credits, opened from About: the notices in the assets' licenses folder. -->
        <activity
            android:name=".LicensesActivity"
            android:exported="false" />

        <!-- Carries the contacts prompt for the Contacts tool, then closes. -->
        <activity
            android:name=".ContactsPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Carries the microphone prompt for the keyboard's mic key, then closes. -->
        <activity
            android:name=".VoicePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".LocalTypeInputMethodService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- The cleaned copy of a pasted image (PastedImages), shared only with the field it is pasted into: not
             exported, and the keyboard grants that app a read through commitContent. No permission, no network. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pastedimages"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pasted_images" />
        </provider>

        <!-- Android's spell checker, answered from the keyboard's word lists and Android's user dictionary. Off until
             chosen in Android's settings. It runs in the main process and needs no permission, network or model. -->
        <service
            android:name=".LocalTypeSpellCheckerService"
            android:exported="true"
            android:label="@string/spell_checker_name"
            android:permission="android.permission.BIND_TEXT_SERVICE">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data
                android:name="android.view.textservice.scs"
                android:resource="@xml/spellchecker" />
        </service>
    </application>
</manifest>
