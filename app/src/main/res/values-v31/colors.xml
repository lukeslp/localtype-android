<resources>
    <!-- Android 12+: follow the wallpaper-derived system palette. -->
    <color name="kb_background">@android:color/system_neutral1_100</color>
    <color name="kb_key">@android:color/system_neutral1_10</color>
    <color name="kb_key_pressed">@android:color/system_neutral1_200</color>
    <color name="kb_modifier">@android:color/system_accent2_100</color>
    <color name="kb_modifier_pressed">@android:color/system_accent2_200</color>
    <color name="kb_accent">@android:color/system_accent1_600</color>
    <color name="kb_accent_pressed">@android:color/system_accent1_700</color>
    <color name="kb_on_key">@android:color/system_neutral1_900</color>
    <color name="kb_on_accent">@android:color/system_accent1_0</color>
